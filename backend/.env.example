# Application Configuration
PROJECT_NAME="Feedback Intelligence Platform"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"
HOST="0.0.0.0"
PORT=8000

# Database Configuration (PostgreSQL + pgvector)
# For local dev without Postgres: sqlite:///./feedback_intelligence.db
DATABASE_URL=postgresql://feedback_user:feedback_password@localhost:5432/feedback_intelligence
TEST_DATABASE_URL=sqlite:///./test_feedback.db

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# LLM Configuration (OpenAI Compatible)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# NLP & Embedding Models
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
SENTIMENT_MODEL=cardiffnlp/twitter-roberta-base-sentiment-latest
INTENT_MODEL=distilbert-base-uncased

# Priority Engine Weights (Normalized sum = 1.0)
PRIORITY_WEIGHT_FREQUENCY=0.25
PRIORITY_WEIGHT_SEVERITY=0.25
PRIORITY_WEIGHT_GROWTH=0.20
PRIORITY_WEIGHT_USER_IMPACT=0.15
PRIORITY_WEIGHT_NEGATIVE_SENTIMENT=0.15
